# Référence des variables (sans valeur). Jamais de secret dans Git.
# Local : copier dans .env.local. Production : importer .env.vercel dans Vercel.

# Postgres Supabase. Production : chaîne « Transaction pooler » (port 6543).
# Migrations (pnpm db:migrate) : connexion directe (port 5432).
DATABASE_URL=

# Supabase Auth (lien magique du propriétaire). Valeurs publiques du projet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seule adresse autorisée à ouvrir l’atelier.
ADMIN_EMAIL=

# Origine publique (canonical, sitemap, données structurées).
NEXT_PUBLIC_SITE_ORIGIN=https://www.boutique-de-boxe.com

# Commerce : simulation par défaut. payplug_test n’ouvre que le test administrateur.
COMMERCE_MODE=simulation
PAYPLUG_API_VERSION=2019-08-06
PAYPLUG_PUBLIC_BASE_URL=https://www.boutique-de-boxe.com
PAYPLUG_TEST_SECRET_KEY=
PAYPLUG_LIVE_SECRET_KEY=

# Reçus par e-mail (adaptateur Resend) ; vide = reçu affiché à l’écran seulement.
RESEND_API_KEY=
MAIL_FROM=

# Google Search Console : contenu de la balise de vérification (facultatif)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools : balise msvalidate.01 (facultatif)
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Boxtal : la carte des points relais au panier (application « Composant carte » sur developer.boxtal.com).
# Sans ces deux clés, le panier explique que la carte ouvre avec les ventes. Gratuit : aucun abonnement, paiement à l’étiquette.
# BOXTAL_ACCESS_KEY=
# BOXTAL_SECRET_KEY=

# Lettre d'ouverture : envoi par SMTP (Brevo). Deux comptes en rotation ; SMTP_2_* facultatif.
# Sans ces variables, l'administration le dit et n'envoie rien.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Boutique de Boxe" <expediteur-verifie@exemple.fr>
# SMTP_2_USER=
# SMTP_2_PASS=
