# Référence des variables. Copier dans .env.local (ignoré par Git) en local ;
# sur Vercel, les renseigner dans Settings → Environment Variables. Jamais dans Git.

# Postgres Supabase. En production, utiliser l’URL du pooler (port 6543, mode transaction).
# Pour les migrations (pnpm db:migrate), utiliser la connexion directe (port 5432).
DATABASE_URL=

# Supabase Auth (lien magique du propriétaire). Clés publiques du projet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seule adresse autorisée à ouvrir l’atelier.
ADMIN_EMAIL=

# Commerce : simulation par défaut. payplug_test n’ouvre que le test administrateur.
COMMERCE_MODE=simulation
PAYPLUG_API_VERSION=2019-08-06
PAYPLUG_PUBLIC_BASE_URL=
PAYPLUG_TEST_SECRET_KEY=
PAYPLUG_LIVE_SECRET_KEY=

# Reçus par e-mail (adaptateur indépendant) ; laisser vide tant qu’aucun fournisseur n’est retenu.
RESEND_API_KEY=
MAIL_FROM=
