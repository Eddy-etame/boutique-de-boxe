# Reference only. For local Cloudflare runtime, copy to .dev.vars (ignored).
# Hosted deployment: configure these in the hosting environment, not in Git.
COMMERCE_MODE=simulation
PAYPLUG_API_VERSION=2019-08-06
PAYPLUG_PUBLIC_BASE_URL=
PAYPLUG_TEST_SECRET_KEY=
PAYPLUG_LIVE_SECRET_KEY=
# Independent receipt-email adapter; populate only after provider setup.
RESEND_API_KEY=
MAIL_FROM=
# Preserve the existing authorized owner configuration on the host.
ADMIN_EMAIL=
